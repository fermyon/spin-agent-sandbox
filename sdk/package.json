{
  "name": "@spinframework/sandbox",
  "version": "0.1.0",
  "description": "An extensible client for sandboxed code execution from a Spin application. Ships a Wasm code-interpreter backend; extensible to other backends.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./interpreter": "./src/interpreter/index.ts",
    "./store": "./src/store/index.ts",
    "./tools": "./src/tools.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:components": "node --test test/components.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "spin",
    "webassembly",
    "sandbox",
    "code-interpreter",
    "agent",
    "tools"
  ],
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
