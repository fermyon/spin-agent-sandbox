package guard:host;

// Same technique as dummy-sockets.wit: a trivial component generated at build
// time via `wasm-tools component embed --dummy`, composed alongside guard-io
// to satisfy spin_sdk's "spin-imports" world (which py-sandbox always pulls
// in) for capabilities this sandbox has no business granting — every
// exported function traps with `unreachable` when called.
world dummy-capabilities {
    export fermyon:spin/rdbms-types@2.0.0;
    export fermyon:spin/llm@2.0.0;
    export fermyon:spin/redis@2.0.0;
    export fermyon:spin/postgres@2.0.0;
    export fermyon:spin/mysql@2.0.0;
    export fermyon:spin/sqlite@2.0.0;
    export fermyon:spin/mqtt@2.0.0;
    export fermyon:spin/variables@2.0.0;
    export spin:postgres/postgres@3.0.0;
    export spin:postgres/postgres@4.0.0;
    export spin:sqlite/sqlite@3.0.0;
    export wasi:keyvalue/store@0.2.0-draft2;
    export wasi:keyvalue/atomics@0.2.0-draft2;
    export wasi:keyvalue/batch@0.2.0-draft2;
    export wasi:config/store@0.2.0-draft-2024-09-27;
}
