package guard:host;

world guard-io {
    // Real wasi:http, pinned to @0.2.10 to exact-match the TS guest's ABI (the
    // Python guest's @0.2.0 imports are semver-wired to it) —
    // kept separate from spin-sdk 4.0.0's own wasi:http@0.2.0 client.
    import wasi:io/poll@0.2.10;
    import wasi:io/error@0.2.10;
    import wasi:clocks/wall-clock@0.2.10;
    import wasi:http/types@0.2.10;
    import wasi:http/outgoing-handler@0.2.10;

    // wac-composed into the guest's matching imports. wasi:io/streams must be
    // exported alongside every interface sharing its stream/descriptor types
    // (stdin, stdout, stderr, http/types, filesystem/*) or the composed
    // component ends up with two definitions of "the same" type and fails
    // validation — see src/stdio.rs. stdin/filesystem are stubs (the sandbox
    // exposes neither to user code).

    export wasi:io/streams@0.2.10;
    export wasi:cli/stdin@0.2.10;
    export wasi:cli/stdout@0.2.10;
    export wasi:cli/stderr@0.2.10;
    export wasi:http/types@0.2.10;
    export wasi:filesystem/types@0.2.10;
    export wasi:filesystem/preopens@0.2.10;
    export fermyon:spin/key-value@2.0.0;
    export wasi:http/outgoing-handler@0.2.10;

    // Exported to guard-front, which sets the sandboxId (KV prefix), allowed
    // hosts and KV flag before calling into the guest, then drains the
    // captured stdout/stderr via take-captured-output afterwards.
    export sandbox:guard/context@0.1.0;
}
