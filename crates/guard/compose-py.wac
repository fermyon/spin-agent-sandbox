// guard-io sits between the guest and host; guard-front is instantiated last as the HTTP entry point.
// Keeping them separate avoids a cycle: guard-front consumes the guest executor, and the guest consumes guard-io.

package local:composed;

let io = new guard:io { ... };
// Dummy components deny raw sockets and unsupported Spin capabilities.
let sockets-dummy = new guard:dummy-sockets { ...io, ... };
let caps-dummy = new guard:dummy-capabilities { ... };

// wac requires explicit bridges from componentize-py's WASI 0.2.0 imports to guard-io's 0.2.10 exports.
let sandbox = new py-sandbox:sandbox {
    "wasi:io/streams@0.2.0": io["wasi:io/streams@0.2.10"],
    "wasi:cli/stdin@0.2.0": io["wasi:cli/stdin@0.2.10"],
    "wasi:cli/stdout@0.2.0": io["wasi:cli/stdout@0.2.10"],
    "wasi:cli/stderr@0.2.0": io["wasi:cli/stderr@0.2.10"],
    "wasi:http/types@0.2.0": io["wasi:http/types@0.2.10"],
    "wasi:http/outgoing-handler@0.2.0": io["wasi:http/outgoing-handler@0.2.10"],
    "wasi:filesystem/types@0.2.0": io["wasi:filesystem/types@0.2.10"],
    "wasi:filesystem/preopens@0.2.0": io["wasi:filesystem/preopens@0.2.10"],
    "wasi:sockets/network@0.2.0": sockets-dummy["wasi:sockets/network@0.2.10"],
    "wasi:sockets/instance-network@0.2.0": sockets-dummy["wasi:sockets/instance-network@0.2.10"],
    "wasi:sockets/tcp@0.2.0": sockets-dummy["wasi:sockets/tcp@0.2.10"],
    "wasi:sockets/tcp-create-socket@0.2.0": sockets-dummy["wasi:sockets/tcp-create-socket@0.2.10"],
    "wasi:sockets/udp@0.2.0": sockets-dummy["wasi:sockets/udp@0.2.10"],
    "wasi:sockets/udp-create-socket@0.2.0": sockets-dummy["wasi:sockets/udp-create-socket@0.2.10"],
    "wasi:sockets/ip-name-lookup@0.2.0": sockets-dummy["wasi:sockets/ip-name-lookup@0.2.10"],
    ...io,
    ...caps-dummy,
    ...
};
let front = new guard:front { ...io, ...sandbox, ... };

export front...;

