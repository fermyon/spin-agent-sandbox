package sandbox:guard@0.1.0;

// Exported by ts-sandbox, imported by guard-front. No stdout/stderr fields here —
// that capture happens in guard-io's guarded wasi:cli/stdout`/`stderr` exports,
// read back via context.take-captured-output after run() returns.
interface executor {
    record run-input {
        method: string,
        path: string,
        headers: list<tuple<string, string>>,
        query: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    // Mirrors wasi:io/streams' pull-based read contract, scoped to this
    // package rather than reusing that interface directly — ts-sandbox would
    // otherwise have to implement wasi:io/streams' full output-stream side too,
    // just to export a resource it only ever produces the input half of.
    // `chunk` = more data, `done` = clean EOF, `error` = the underlying stream
    // broke mid-read (e.g. an upstream fetch failed).
    variant body-chunk {
        chunk(list<u8>),
        done,
        error(string),
    }

    // Owned by guard-front once returned in `handler-response`; pulled via
    // repeated `read` calls until `done`. Status/headers are already
    // committed by the time any `error` surfaces, so the host can only
    // abort/truncate the body at that point, not report a different status.
    resource body-stream {
        read: func() -> body-chunk;
    }

    record handler-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: body-stream,
    }

    variant outcome {
        handler-response(handler-response),
        // None = success, Some(stack) = uncaught error in "main" shape.
        main(option<string>),
        // Syntax/transpile error, or a malformed `input` — a client error (400).
        compile-error(string),
        // The handler shape's `fetch()` threw — a server error (500).
        handler-error(string),
    }

    run: func(code: string, input: option<run-input>) -> outcome;
}

world executor-host {
    export executor;
}
