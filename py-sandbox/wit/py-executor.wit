package py-sandbox:sandbox;

// No imports declared here at all — componentize-py always forces its own
// bundled @0.2.0 defaults for everything a Python "command" component needs
// (wasi:cli/*, wasi:clocks/*, wasi:filesystem/*, wasi:io/*, wasi:random/*,
// wasi:sockets/*) regardless of what this world declares, and fermyon:spin/
// key-value + wasi:http/* come from the real spin-sdk package's own world
world py-executor {
    export sandbox:guard/executor@0.1.0;
}
